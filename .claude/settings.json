{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git worktree list *)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git merge --ff-only origin/main)",
      "Bash(gh auth status *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh label list *)",
      "Bash(gh api repos/enqii/frame-scout/pulls/*)",
      "Bash(gh api repos/enqii/frame-scout/issues/*)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(../../../.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe framescout_engine.py --help)",
      "Bash(../../../.venv/Scripts/python.exe framescout_engine.py --help)",
      "Bash(.venv/Scripts/python.exe framescout_engine.py .tmp/* --output .tmp/*)",
      "Bash(../../../.venv/Scripts/python.exe framescout_engine.py .tmp/* --output .tmp/*)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m pytest *)",
      "PowerShell(..\\..\\..\\.venv\\Scripts\\python.exe -m pytest *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh api repos/enqii/frame-scout/pulls/*/merge*)",
      "Bash(git branch -D *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git worktree remove *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main*)",
      "PowerShell(git reset --hard *)"
    ]
  }
}
